# Durga Mandal Application - Environment Configuration
# Copy this file to .env and replace with your official credentials

# 1. Firebase Web App Config (Phone Authentication द्वारे SMS साठी)
VITE_FIREBASE_API_KEY=AIzaSyDummyKeyForDevelopmentAndDemoPurposes
VITE_FIREBASE_AUTH_DOMAIN=durga-mandal-app.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=durga-mandal-app
VITE_FIREBASE_STORAGE_BUCKET=durga-mandal-app.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef123456

# 2. Fast2SMS API Key (भारतीय मोफत/सुलभ SMS Gateway साठी)
# www.fast2sms.com वरून मोफत API Key मिळवा आणि येथे टाका
VITE_FAST2SMS_API_KEY=

# 3. Razorpay Client Key (Public Key)
VITE_RAZORPAY_KEY_ID=rzp_test_DurgaMandalPublicDemoKey
