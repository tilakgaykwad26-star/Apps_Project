rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- Helper Functions ---
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/dm_users/$(request.auth.uid)).data;
    }
    
    function hasRole(role) {
      return isAuthenticated() && (
        request.auth.token.role == role || 
        getUserData().role == role
      );
    }
    
    function isSuperAdmin() {
      return hasRole('super_admin');
    }
    
    function isTreasurer() {
      return hasRole('treasurer') || isSuperAdmin();
    }
    
    function isCommitteeAdmin() {
      return hasRole('committee_admin') || isSuperAdmin();
    }
    
    function isContentManager() {
      return hasRole('content_manager') || isCommitteeAdmin() || isSuperAdmin();
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // --- Users Collection ---
    match /dm_users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isOwner(userId);
      allow update: if isOwner(userId) || isSuperAdmin();
      allow delete: if isSuperAdmin();
    }
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isOwner(userId);
      allow update: if isOwner(userId) || isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    // --- Members Collection ---
    match /dm_members/{memberId} {
      allow read: if true;
      allow write: if true; // Allows offline demo sync & committee admins
    }
    match /members/{memberId} {
      allow read: if true;
      allow write: if true;
    }

    // --- Events & RSVPs ---
    match /dm_events/{eventId} {
      allow read: if true;
      allow write: if true;
    }
    match /events/{eventId} {
      allow read: if true;
      allow write: if true;
    }
    
    match /dm_event_rsvps/{rsvpId} {
      allow read, write: if true;
    }
    match /event_rsvps/{rsvpId} {
      allow read, write: if true;
    }

    // --- Photo Gallery & Images ---
    match /dm_albums/{albumId} {
      allow read: if true;
      allow write: if true;
    }
    match /dm_images/{imageId} {
      allow read: if true;
      allow write: if true;
    }
    match /gallery_albums/{albumId} {
      allow read: if true;
      allow write: if true;
    }
    match /gallery_images/{imageId} {
      allow read: if true;
      allow write: if true;
    }

    // --- Notices & Announcements ---
    match /dm_notices/{noticeId} {
      allow read: if true;
      allow write: if true;
    }
    match /notices/{noticeId} {
      allow read: if true;
      allow write: if true;
    }

    // --- Donations & Offerings ---
    match /dm_donations/{donationId} {
      allow read, write: if true;
    }
    match /donations/{donationId} {
      allow read, write: if true;
    }

    // --- Member Payments & Ledger ---
    match /dm_payments/{paymentId} {
      allow read, write: if true;
    }
    match /payments/{paymentId} {
      allow read, write: if true;
    }

    // --- Expenses ---
    match /dm_expenses/{expenseId} {
      allow read, write: if true;
    }
    match /expenses/{expenseId} {
      allow read, write: if true;
    }

    // --- Sponsors ---
    match /dm_sponsors/{sponsorId} {
      allow read: if true;
      allow write: if true;
    }
    match /sponsors/{sponsorId} {
      allow read: if true;
      allow write: if true;
    }

    // --- Committee Members ---
    match /dm_committee/{memberId} {
      allow read: if true;
      allow write: if true;
    }
    match /committee_members/{memberId} {
      allow read: if true;
      allow write: if true;
    }

    // --- Live Stream & Presence ---
    match /dm_live_stream/{docId} {
      allow read: if true;
      allow write: if true;
    }
    match /dm_live_presence/{sessionId} {
      allow read, write: if true;
    }

    // --- Security Audit Logs & Config ---
    match /dm_audit_logs/{logId} {
      allow read, write: if true;
    }
    match /dm_config/{configId} {
      allow read: if true;
      allow write: if true;
    }
    match /settings/{settingId} {
      allow read, write: if true;
    }
  }
}
