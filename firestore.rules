rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- Helper Functions ---
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function hasRole(role) {
      return isAuthenticated() && (
        request.auth.token.role == role || 
        getUserData().role == role
      );
    }
    
    function isSuperAdmin() {
      return hasRole('super_admin');
    }
    
    function isTreasurer() {
      return hasRole('treasurer') || isSuperAdmin();
    }
    
    function isCommitteeAdmin() {
      return hasRole('committee_admin') || isSuperAdmin();
    }
    
    function isContentManager() {
      return hasRole('content_manager') || isCommitteeAdmin() || isSuperAdmin();
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // --- Users Collection ---
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isOwner(userId);
      allow update: if isOwner(userId) || isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    // --- Members Collection ---
    match /members/{memberId} {
      allow read: if isCommitteeAdmin() || (isAuthenticated() && resource.data.uid == request.auth.uid);
      allow create: if isCommitteeAdmin() || isAuthenticated();
      allow update: if isCommitteeAdmin() || (isAuthenticated() && resource.data.uid == request.auth.uid);
      allow delete: if isSuperAdmin();
    }

    // --- Events & RSVPs ---
    match /events/{eventId} {
      allow read: if true; // Public read
      allow create, update, delete: if isContentManager();
    }
    
    match /event_rsvps/{rsvpId} {
      allow read: if isContentManager() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if true; // Public or authenticated RSVP
      allow update, delete: if isContentManager();
    }

    // --- Photo Gallery & Images ---
    match /gallery_albums/{albumId} {
      allow read: if true;
      allow create, update, delete: if isContentManager();
    }
    
    match /gallery_images/{imageId} {
      allow read: if true;
      allow create, update, delete: if isContentManager();
    }

    // --- Notices & Announcements ---
    match /notices/{noticeId} {
      allow read: if true;
      allow create, update, delete: if isContentManager();
    }

    // --- Donations & Offerings ---
    match /donations/{donationId} {
      allow read: if isTreasurer() || (isAuthenticated() && resource.data.donorPhone == request.auth.token.phone_number);
      // Client cannot directly mark donation as successful without Cloud Function signature verification
      allow create: if true;
      allow update, delete: if isTreasurer();
    }

    // --- Member Payments & Ledger ---
    match /payments/{paymentId} {
      allow read: if isTreasurer() || (isAuthenticated() && resource.data.memberId == getUserData().memberId);
      allow create, update: if isTreasurer();
      allow delete: if isSuperAdmin();
    }

    // --- Sponsors ---
    match /sponsors/{sponsorId} {
      allow read: if true;
      allow create, update, delete: if isCommitteeAdmin();
    }

    // --- Mandal Public Info & Committee ---
    match /mandal_info/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /committee_members/{memberId} {
      allow read: if true;
      allow write: if isCommitteeAdmin();
    }

    // --- Security Audit Logs ---
    match /audit_logs/{logId} {
      allow read: if isSuperAdmin();
      allow write: if isTreasurer() || isCommitteeAdmin() || isSuperAdmin();
    }

    // --- System Settings ---
    match /settings/{settingId} {
      allow read: if isTreasurer() || isSuperAdmin();
      allow write: if isSuperAdmin();
    }
  }
}
